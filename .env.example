# ==========================================
# Faralist Landing Page & CMS - Environment Variables
# ==========================================

# Port that the Next.js container listens to internally and maps to on host
PORT=3000

# Secret key for Payload CMS sessions, encryption and authentication
# Generate a random 32+ characters key (e.g. openssl rand -base64 32)
PAYLOAD_SECRET=faralist-secret-payload-token-2026-production-ready

# SQLite Database connection string
# Keep as file:./payload.db to use the mounted SQLite volume
DATABASE_URI=file:./payload.db

# Canonical domain URL (without trailing slash)
NEXT_PUBLIC_SERVER_URL=https://faralist.com
